{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Backend Dev Server",
			"type": "shell",
			"command": "npm",
			"args": ["run", "dev"],
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Start Frontend Dev Server",
			"type": "shell",
			"command": "npm",
			"args": ["run", "dev"],
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Type Check Backend",
			"type": "shell",
			"command": "npm",
			"args": ["run", "type-check"],
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"group": "test"
		},
		{
			"label": "Type Check Frontend", 
			"type": "shell",
			"command": "npm",
			"args": ["run", "type-check"],
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"group": "test"
		}
	]
}